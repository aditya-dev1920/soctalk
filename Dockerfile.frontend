# =============================================================================
# SocTalk Frontend - Multi-stage production build (adapter-node)
# =============================================================================

FROM node:20-alpine AS builder
WORKDIR /app

# Disable SSL verification for corporate proxy / VPN SSL inspection
ENV NODE_TLS_REJECT_UNAUTHORIZED=0

RUN npm config set strict-ssl false && \
    npm install -g pnpm@9.15.0 && \
    pnpm config set strict-ssl false

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm build

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/build ./build
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

ENV PORT=3000 \
    HOST=0.0.0.0 \
    NODE_ENV=production

RUN addgroup -S -g 10001 svelte \
    && adduser -S -u 10001 -G svelte svelte \
    && chown -R svelte:svelte /app
USER svelte

EXPOSE 3000
CMD ["node", "build"]